# Copy this file to .env.local (dev) or set these as env vars on the server (prod).
# Never commit .env.local — it's git-ignored.

# Gemini API keys (required, SERVER-SIDE ONLY).
# The backend round-robins across all configured keys with a per-key cool-off
# on 429s, so adding 3-4 keys lets heavy batch runs spread their load without
# choking any single key's quota.
#
# Pick ONE of these three configurations:
#
# (a) Easiest — comma-separated list in a single env var:
GEMINI_API_KEYS="key_one_here,key_two_here,key_three_here"
#
# (b) Numbered env vars (handy if your secret store doesn't like commas):
# GEMINI_API_KEY_1="..."
# GEMINI_API_KEY_2="..."
# GEMINI_API_KEY_3="..."
#
# (c) Single key (legacy fallback — fine for low-volume use):
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
#
# Get keys at https://aistudio.google.com/app/apikey

# Optional: override the Gemini model. Defaults to gemini-3.1-pro-preview.
# GEMINI_MODEL="gemini-2.5-pro"

# Optional: fallback model used only after the first generation attempt fails.
# Defaults to gemini-2.5-flash.
# GEMINI_FAST_MODEL="gemini-2.5-flash"

# Sign-in and glossary (required): Supabase project "cg-glossary".
# The publishable key is safe in the browser; reads run as the signed-in user under row-level security.
# VITE_* values are baked into the frontend at build time; the server reads the same values.
VITE_SUPABASE_URL="https://grimpkecuvybjkpicaoo.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_HWj40vykmAqhPwa4Gdvs2w_0_dZPRCP"

# Only accounts on this domain can sign in (also enforced by a database trigger).
# ALLOWED_EMAIL_DOMAIN="convegenius.ai"
# VITE_ALLOWED_EMAIL_DOMAIN="convegenius.ai"

# Optional: set to "false" to lock only approved glossary terms (default also uses
# textbook-attested candidates, marked PREFERRED in the prompt).
# GLOSSARY_INCLUDE_CANDIDATES="true"

# Optional: HTTP port the Express server listens on. Defaults to 8080.
# PORT=8080

# Optional (dev only): where the Vite dev server should proxy /api requests.
# Defaults to http://localhost:8080.
# BACKEND_URL="http://localhost:8080"
